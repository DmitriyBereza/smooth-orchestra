{
  "name": "smooth-orchestra",
  "version": "0.1.0",
  "description": "Smooth Orchestra — orchestrate multiple Claude Code CLI agents as a virtual AI software development team",
  "main": "dist/main/server-standalone.js",
  "author": "Dmytro Bereza",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,green \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsc -p tsconfig.json && node dist/main/server-standalone.js",
    "dev:ui": "vite --config vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config vite.config.ts",
    "start": "node dist/main/server-standalone.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "geist": "^1.7.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  }
}
