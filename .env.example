# Smooth Orchestra — Environment Variables
#
# Copy this file to .env and fill in your values.
# All variables are optional — defaults are shown.

# JWT signing secret. If unset, an ephemeral random secret is generated
# on each server start (tokens won't survive restarts).
# Recommended: set a strong secret for persistent sessions.
# JWT_SECRET=your-secret-here

# Port for the Express + Socket.io backend server (default: 3333)
# AUTH_PORT=3333

# Seed admin user created on first run when no users exist.
# SEED_EMAIL=admin@orchestra.local
# SEED_PASSWORD=orchestra
